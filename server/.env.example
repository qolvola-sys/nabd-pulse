# ── الشبكة ────────────────────────────────────────────────────────────────
PORT=8787

# العنوان العام للخادم (بدون / في النهاية). هذا هو نفس العنوان المسجّل في
# Redirect URI داخل تطبيق TikTok Developer.
PUBLIC_BASE_URL=https://api.example.com

# ── الأمان ────────────────────────────────────────────────────────────────
# مفتاح يرسله التطبيق في ترويسة Authorization: Bearer <API_TOKEN>
# أنشئه بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=please-change-me

# مفتاح تشفير توكنات TikTok داخل قاعدة البيانات (32 بايت عشوائية، hex أو أي نص طويل)
TOKEN_ENC_KEY=please-change-this-too

# ── TikTok Developer ──────────────────────────────────────────────────────
# من https://developers.tiktok.com/ → تطبيقك → Keys
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# يجب أن يطابق تماماً ما سجّلته في التطبيق
TIKTOK_REDIRECT_URI=https://api.example.com/auth/tiktok/callback

# الصلاحيات: معلومات الحساب + الإحصاءات + قائمة الفيديوهات
TIKTOK_SCOPES=user.info.basic,user.info.stats,video.list

# ── التشغيل ───────────────────────────────────────────────────────────────
# 1 = بيانات تجريبية جاهزة (يعمل التطبيق فوراً بدون مفاتيح TikTok)
DEMO_MODE=1

# الحد الأقصى لعدد الفيديوهات التي نسحبها لكل حساب عند كل مزامنة
MAX_VIDEOS_PER_ACCOUNT=200

# عدد الحسابات التي تُزامن بالتوازي (TikTok يحدّ الطلبات، لا ترفعها كثيراً)
SYNC_CONCURRENCY=2

# مدة صلاحية الكاش بالثواني (لا نضرب الـ API قبل انتهائها)
CACHE_TTL_SECONDS=900

DATA_DIR=./data
